# Copy this file to .env.production and replace every placeholder before starting.
# SMARTVOLT_DOMAIN must be a real DNS name pointing to this server.
SMARTVOLT_DOMAIN=smartvolt.example.com

# Use long random hex strings (for example: python -c "import secrets; print(secrets.token_hex(32))").
POSTGRES_USER=smartvolt
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_CHARACTER_HEX_VALUE
AUTH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHARACTER_HEX_VALUE

ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
