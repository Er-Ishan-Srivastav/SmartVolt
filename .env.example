APP_NAME=SmartVolt API
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./smartvolt.db
DEFAULT_TARIFF_PER_KWH=8.0
SIMULATOR_INTERVAL_SECONDS=3600
SIMULATOR_MIN_KWH=0.05
SIMULATOR_MAX_KWH=0.50
# For local simulation only. Replace AUTH_SECRET with a long random value before deployment.
AUTH_SECRET=change-this-local-demo-secret-before-deployment
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
