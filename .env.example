# For local development without Docker, keep SQLite:
DATABASE_URL=sqlite:///./smartvolt.db

# For Docker Compose, use the PostgreSQL URL from docker-compose.yml.
APP_NAME=SmartVolt API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_TARIFF_PER_KWH=8.00
SIMULATOR_INTERVAL_SECONDS=3600
SIMULATOR_MIN_KWH=0.05
SIMULATOR_MAX_KWH=0.50
