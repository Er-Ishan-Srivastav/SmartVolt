APP_NAME=SmartVolt API
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./smartvolt.db
DEFAULT_TARIFF_PER_KWH=8.0
# The worker is opt-in locally so it cannot silently consume demo balances.
SIMULATOR_ENABLED=false
SIMULATOR_INTERVAL_SECONDS=3600
SIMULATOR_MIN_KWH=0.05
SIMULATOR_MAX_KWH=0.50
# Educational estimate defaults: CEA v22.0 FY 2025-26 weighted average (kg CO2/kWh).
GRID_CO2_FACTOR_KG_PER_KWH=0.675
TREE_CO2_ABSORPTION_KG_PER_YEAR=22.0
# For local simulation only. Replace AUTH_SECRET with a long random value before deployment.
AUTH_SECRET=change-this-local-demo-secret-before-deployment
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
